# Пример 10: к каждому из чисел в ячейках 0050–0077 прибавляется число из 0100.
# Источник: А. И. Китов, Н. А. Криницкий, «Электронные цифровые машины и программирование», 1959, § 28, групповые операции, с. 139.
# В книге напечатаны только две команды; они размещены с 0010, добавлен останов.
# Результаты — двоичные числа на местах исходных.
START 0010
0010 0000 0027 0000 0 35
0011 0050 0100 0050 0 01
0012 0000 0000 0000 0 40
# Пример исходных данных: числа 0, 1, …, 23 и прибавляемое 0,5; в книге они не заданы.
# 0050: 0
0050 0000 0000 0000 0 00
# 0051: 1
0051 2000 0000 0000 0 01
# 0052: 2
0052 2000 0000 0000 0 02
# 0053: 3
0053 3000 0000 0000 0 02
# 0054: 4
0054 2000 0000 0000 0 03
# 0055: 5
0055 2400 0000 0000 0 03
# 0056: 6
0056 3000 0000 0000 0 03
# 0057: 7
0057 3400 0000 0000 0 03
# 0060: 8
0060 2000 0000 0000 0 04
# 0061: 9
0061 2200 0000 0000 0 04
# 0062: 10
0062 2400 0000 0000 0 04
# 0063: 11
0063 2600 0000 0000 0 04
# 0064: 12
0064 3000 0000 0000 0 04
# 0065: 13
0065 3200 0000 0000 0 04
# 0066: 14
0066 3400 0000 0000 0 04
# 0067: 15
0067 3600 0000 0000 0 04
# 0070: 16
0070 2000 0000 0000 0 05
# 0071: 17
0071 2100 0000 0000 0 05
# 0072: 18
0072 2200 0000 0000 0 05
# 0073: 19
0073 2300 0000 0000 0 05
# 0074: 20
0074 2400 0000 0000 0 05
# 0075: 21
0075 2500 0000 0000 0 05
# 0076: 22
0076 2600 0000 0000 0 05
# 0077: 23
0077 2700 0000 0000 0 05
# 0100: 0,5
0100 2000 0000 0000 0 00
