# Корень уравнения x^3/65 + x − 5,001 = 0 методом итераций
# x(i+1) = 5,001 − x(i)^3/65 при x0 = 4, пока |x(i+1) − x(i)| ≥ 0,0001.
# Источник: А. И. Китов, Н. А. Криницкий, «Электронные цифровые машины и программирование», 1959, § 33, пример 1, с. 166–167.
# Буквенные адреса заменены числами по распределению памяти из книги:
# a = 0017, b = 0033, c = 0037. Останов в книге напечатан как b+14; это a+14.
# Исходные данные из книги стоят в ячейках 0034–0037; число 1/65 округлено
# до девяти цифр. Корень ≈ 4,00944774 остаётся в ячейке 0034.
START 0020
0020 0034 0003 0034 0 72
0021 0034 0000 0040 0 13
0022 0040 0040 0041 0 05
0023 0040 0041 0041 0 05
0024 0036 0041 0041 0 05
0025 0035 0041 0034 0 03
0026 0034 0040 0040 0 03
0027 0040 0037 0000 0 04
0030 0021 0031 0000 0 20
0031 0034 0000 0034 0 70
0032 0034 0000 0000 0 44
0033 0000 0000 0000 0 40
0034 1000 0000 0000 0 01
0035 1200 0200 0000 0 01
0036 0251 6043 0252 0 41
0037 0200 0000 0000 0 43
