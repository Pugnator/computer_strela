# Пример 9: сумма чисел из ячеек 0101–0120 записывается в ячейку 0121.
# Источник: А. И. Китов, Н. А. Криницкий, «Электронные цифровые машины и программирование», 1959, § 28, групповые операции, с. 139.
# В книге напечатаны только две команды; они размещены с 0010, добавлен останов.
# Ответ — двоичное число в ячейке 0121.
START 0010
0010 0000 0017 0000 0 34
0011 0101 0121 0121 0 01
0012 0000 0000 0000 0 40
# Пример исходных данных: двоичные числа 1, 2, …, 16; в книге они не заданы.
# 0101: 1
0101 2000 0000 0000 0 01
# 0102: 2
0102 2000 0000 0000 0 02
# 0103: 3
0103 3000 0000 0000 0 02
# 0104: 4
0104 2000 0000 0000 0 03
# 0105: 5
0105 2400 0000 0000 0 03
# 0106: 6
0106 3000 0000 0000 0 03
# 0107: 7
0107 3400 0000 0000 0 03
# 0110: 8
0110 2000 0000 0000 0 04
# 0111: 9
0111 2200 0000 0000 0 04
# 0112: 10
0112 2400 0000 0000 0 04
# 0113: 11
0113 2600 0000 0000 0 04
# 0114: 12
0114 3000 0000 0000 0 04
# 0115: 13
0115 3200 0000 0000 0 04
# 0116: 14
0116 3400 0000 0000 0 04
# 0117: 15
0117 3600 0000 0000 0 04
# 0120: 16
0120 2000 0000 0000 0 05
