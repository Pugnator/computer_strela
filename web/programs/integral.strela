# Определённый интеграл от t^n в пределах от 1 до x (x > 0).
# При n ≠ −1 машина считает (x^(n+1) − 1)/(n+1), при n = −1 — ln x.
# Источник: А. И. Китов, Н. А. Криницкий, «Электронные цифровые машины и программирование», 1959, § 31, пример 1, с. 155–156.
# Исходные данные: 0037 — x, 0040 — n, 0041 — число −1. Ответ: ячейка 0044,
# затем он переводится в десятичную запись и выдаётся на перфокарту.
START 0020
0004 0000 0021 0020 0 41
0020 0037 0002 0037 0 72
0021 0040 0041 0000 0 16
0022 0033 0023 0000 0 20
0023 0040 0041 0042 0 03
0024 0037 0000 0043 0 66
0025 0042 0043 0043 0 05
0026 0043 0000 0043 0 64
0027 0043 0041 0043 0 01
0030 0042 0000 0042 0 62
0031 0042 0043 0044 0 05
0032 0034 0034 0000 0 20
0033 0037 0000 0044 0 66
0034 0044 0000 0044 0 70
0035 0044 0000 0000 0 44
0036 0000 0000 0000 0 40
0041 4200 0000 0000 0 01
# Пример исходных данных; в книге значения x и n не заданы.
# 0037: x = 2
0037 0400 0000 0000 0 01
# 0040: n = 3; ответ (2^4 − 1)/4 = 3,75
0040 0600 0000 0000 0 01
